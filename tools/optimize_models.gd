extends SceneTree
## Turns raw downloaded glTF archives into lean game GLBs (ENVIRONMENT.md §10, 3DMODELS.md §11):
## textures are capped (2K buildings, 1K props/foliage) and re-encoded as lossy WebP (alpha kept),
## everything is packed into one .glb, and each model's bounds go into a manifest so level code can
## place it at real-world scale. Runtime LODs are generated by Godot's importer afterwards.
##   godot --headless --path . -s res://tools/optimize_models.gd -- <raw_dir> <key>:<max_px> ...
## <raw_dir>/<key>/ must contain scene.gltf (Sketchfab archive layout).

const OUT_DIR := "res://assets/third_party/sketchfab/%s"
const MANIFEST := "res://assets/third_party/sketchfab/manifest.json"


func _initialize() -> void:
	var args := OS.get_cmdline_user_args()
	var raw: String = args[0]
	var manifest := {}
	if FileAccess.file_exists(MANIFEST):
		manifest = JSON.parse_string(FileAccess.get_file_as_string(MANIFEST))
	for spec in args.slice(1):
		var parts := spec.split(":")
		var key := parts[0]
		var max_px := int(parts[1]) if parts.size() > 1 else 2048
		var src := "%s/%s/scene.gltf" % [raw, key]
		if not FileAccess.file_exists(src):
			push_error("missing " + src)
			continue
		var doc := GLTFDocument.new()
		var state := GLTFState.new()
		if doc.append_from_file(src, state) != OK:
			push_error("cannot read " + src)
			continue
		var scene := doc.generate_scene(state)
		var shrunk := _shrink_textures(scene, max_px)
		var aabb := _bounds(scene)
		DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(OUT_DIR % key))
		var out_doc := GLTFDocument.new()
		out_doc.image_format = "Lossy WebP"
		out_doc.lossy_quality = 0.82
		var out_state := GLTFState.new()
		out_doc.append_from_scene(scene, out_state)
		var out_path := ProjectSettings.globalize_path((OUT_DIR % key) + "/%s.glb" % key)
		var err := out_doc.write_to_filesystem(out_state, out_path)
		manifest[key] = {"size": [aabb.size.x, aabb.size.y, aabb.size.z], "min": [aabb.position.x, aabb.position.y, aabb.position.z]}
		print("%s -> %s (err %d) textures shrunk %d, bounds %s" % [key, out_path.get_file(), err, shrunk, aabb.size])
		scene.free()
	var f := FileAccess.open(MANIFEST, FileAccess.WRITE)
	f.store_string(JSON.stringify(manifest, "  "))
	quit()


func _shrink_textures(root: Node, max_px: int) -> int:
	var done := {}
	var count := 0
	for mi: MeshInstance3D in root.find_children("*", "MeshInstance3D", true, false):
		if mi.mesh == null:
			continue
		for s in mi.mesh.get_surface_count():
			var mat := mi.mesh.surface_get_material(s) as BaseMaterial3D
			if mat == null or done.has(mat):
				continue
			done[mat] = true
			for prop in ["albedo_texture", "normal_texture", "roughness_texture", "metallic_texture", "emission_texture", "ao_texture"]:
				var tex := mat.get(prop) as Texture2D
				if tex == null:
					continue
				var img := tex.get_image()
				if img == null:
					continue
				if img.is_compressed():
					img.decompress()
				var w := img.get_width()
				var h := img.get_height()
				if maxi(w, h) > max_px:
					var k := float(max_px) / maxi(w, h)
					img.resize(maxi(4, int(w * k)), maxi(4, int(h * k)), Image.INTERPOLATE_LANCZOS)
					count += 1
				mat.set(prop, ImageTexture.create_from_image(img))
	return count


func _bounds(root: Node) -> AABB:
	var out := AABB()
	var first := true
	for mi: MeshInstance3D in root.find_children("*", "MeshInstance3D", true, false):
		if mi.mesh == null:
			continue
		var xf := _relative(root, mi)
		var b := xf * mi.get_aabb()
		out = b if first else out.merge(b)
		first = false
	return out


func _relative(root: Node, node: Node3D) -> Transform3D:
	var xf := node.transform
	var p := node.get_parent()
	while p != null and p != root:
		if p is Node3D:
			xf = (p as Node3D).transform * xf
		p = p.get_parent()
	return xf
